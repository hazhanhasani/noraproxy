<Window x:Class="NoraProxy.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NoraProxy — Windows" Width="1160" Height="770" MinWidth="930" MinHeight="670"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft"
        Background="{StaticResource CanvasBrush}" FontFamily="Segoe UI">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="78"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="32"/>
    </Grid.RowDefinitions>
    <!-- Android UI 3.0 identity: graphite, mint accent, clear connection state. -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="52" Height="52" CornerRadius="17" Background="#233D42" BorderBrush="#477B78" BorderThickness="1">
          <TextBlock Text="N" FontWeight="ExtraBold" FontSize="30" Foreground="{StaticResource AccentBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="NoraProxy" FontSize="25" FontWeight="ExtraBold" FlowDirection="LeftToRight"/>
          <TextBlock x:Name="HeaderVersion" Text="Windows Preview" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
        </StackPanel>
      </StackPanel>
      <Border Grid.Column="1" CornerRadius="24" Background="#28343F" Padding="15,9" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="●" Foreground="#F5C78A" FontSize="14" Margin="0,0,7,0"/>
          <TextBlock x:Name="HeaderStatus" Text="موتور ویندوز در دست توسعه" Foreground="#E5EAF0" FontSize="12"/>
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="215"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#182431" CornerRadius="22" Padding="15,20">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="4,0,4,5">
            <Separator Background="#40505B" Margin="0,0,0,14"/>
            <TextBlock Text="NoraProxy · Windows" Foreground="{StaticResource AccentBrush}" FontSize="13" FontWeight="Bold"/>
            <TextBlock Text="هم‌هویت با Android UI 3.0" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0"/>
          </StackPanel>
          <StackPanel>
            <TextBlock Text="دسترسی سریع" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="6,0,6,15"/>
            <Button x:Name="HomeNavButton" Content="⌂    صفحه اصلی" Click="Home_Click" Style="{StaticResource NavButtonStyle}"/>
            <Button x:Name="LocationsNavButton" Content="◎    لوکیشن‌ها" Click="Locations_Click" Style="{StaticResource NavButtonStyle}"/>
            <Button x:Name="SubscriptionsNavButton" Content="▤    اشتراک‌ها" Click="Subscriptions_Click" Style="{StaticResource NavButtonStyle}"/>
            <Button x:Name="SettingsNavButton" Content="⚙    تنظیمات و آپدیت" Click="Settings_Click" Style="{StaticResource NavButtonStyle}"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Grid.Column="2" Background="#141E2A" CornerRadius="22" Padding="22,20">
        <Grid>
          <!-- No scrolling on the home panel. Native VPN is not yet available. -->
          <Grid x:Name="HomePage">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
              <TextBlock Text="داشبورد اتصال" Style="{StaticResource TitleStyle}"/>
              <TextBlock Text="همه اطلاعات مهم در یک نگاه" Style="{StaticResource MutedStyle}" FontSize="12"/>
            </StackPanel>
            <Border Grid.Row="1" CornerRadius="22" Background="#1B2935" Margin="0,13,0,11" Padding="13">
              <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Border CornerRadius="26" Background="#33423C" Padding="13,5" HorizontalAlignment="Center">
                    <TextBlock Text="○  اتصال غیرفعال" Foreground="#F4D29C" FontSize="12" FontWeight="Bold"/>
                  </Border>
                  <Border Width="145" Height="145" CornerRadius="76" Margin="0,12,0,9"
                          Background="#20333C" BorderBrush="#76EAD0" BorderThickness="5">
                    <Border Width="105" Height="105" CornerRadius="55" Background="#1B2D37"
                            BorderBrush="#3A6065" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock Text="⏻" Foreground="{StaticResource AccentBrush}" FontSize="63"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </Border>
                  <TextBlock Text="آماده تکمیل موتور VPN ویندوز" FontSize="17" FontWeight="Bold"
                             HorizontalAlignment="Center" TextAlignment="Center"/>
                  <TextBlock Text="در این پیش‌نمایش اتصال واقعی فعال نیست" Foreground="{StaticResource MutedBrush}"
                             Margin="0,5,0,0" FontSize="12" TextAlignment="Center"/>
                  <Button x:Name="ConnectButton" Content="اتصال — در دست توسعه" IsEnabled="False"
                          Width="258" Margin="0,13,0,0"/>
                </StackPanel>
              </Grid>
            </Border>
            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Background="#223341" Padding="12" CornerRadius="15">
                <StackPanel>
                  <TextBlock Text="اشتراک ذخیره‌شده" Style="{StaticResource MutedStyle}" FontSize="11"/>
                  <TextBlock x:Name="HomeSubscriptionCount" Text="۰" Foreground="{StaticResource AccentBrush}" FontSize="23" FontWeight="Bold"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Background="#223341" Padding="12" CornerRadius="15">
                <StackPanel>
                  <TextBlock Text="پینگ واقعی" Style="{StaticResource MutedStyle}" FontSize="11"/>
                  <TextBlock Text="نامشخص" Foreground="{StaticResource MutedBrush}" FontSize="16" FontWeight="Bold" Margin="0,3,0,0"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="4" Background="#223341" Padding="12" CornerRadius="15">
                <StackPanel>
                  <TextBlock Text="لوکیشن فعال" Style="{StaticResource MutedStyle}" FontSize="11"/>
                  <TextBlock Text="انتخاب نشده" Foreground="{StaticResource MutedBrush}" FontSize="15" FontWeight="Bold" Margin="0,3,0,0"/>
                </StackPanel>
              </Border>
            </Grid>
            <Border Grid.Row="3" CornerRadius="15" Background="#223341" Margin="0,10,0,0" Padding="12">
              <DockPanel>
                <Button DockPanel.Dock="Left" Content="مشاهده لوکیشن‌ها ←" Click="Locations_Click"
                        Background="#315049" BorderBrush="#517A6F" Margin="10,0,0,0"/>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="🌐  انتخاب کشور" FontSize="13" FontWeight="Bold"/>
                  <TextBlock Text="پس از اتصال موتور، کشورهای واقعی اینجا نمایش داده می‌شوند"
                             Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
              </DockPanel>
            </Border>
          </Grid>

          <ScrollViewer x:Name="LocationsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="لوکیشن‌ها" Style="{StaticResource TitleStyle}"/>
              <TextBlock Text="جست‌وجو، علاقه‌مندی و انتخاب سریع کشورها — پس از فعال‌سازی موتور ویندوز"
                         Style="{StaticResource MutedStyle}" FontSize="12"/>
              <TextBox x:Name="CountrySearch" IsEnabled="False" Margin="0,16,0,10"
                       Style="{StaticResource InputStyle}" ToolTip="هنوز فهرست واقعی سرورها در ویندوز آماده نیست"
                       Text="جست‌وجوی کشور..." />
              <Border Background="#223341" CornerRadius="20" Padding="32" Margin="0,10,0,0">
                <StackPanel HorizontalAlignment="Center">
                  <TextBlock Text="🌐" FontSize="45" HorizontalAlignment="Center"/>
                  <TextBlock Text="هنوز لوکیشن قابل انتخابی وجود ندارد" FontSize="18"
                             FontWeight="Bold" Margin="0,14,0,8" TextAlignment="Center"/>
                  <TextBlock Text="تا اتصال موتور Xray/TUN، کشور و پینگ ساختگی نمایش داده نمی‌شود."
                             Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <Grid x:Name="SubscriptionsPage" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
              <TextBlock Text="اشتراک‌های من" Style="{StaticResource TitleStyle}"/>
              <TextBlock Text="ورودی‌ها رمزگذاری می‌شوند و روی همین رایانه باقی می‌مانند"
                         Style="{StaticResource MutedStyle}" FontSize="12"/>
              <Expander Header="＋ افزودن ساب یا کانفیگ" IsExpanded="True"
                        Margin="0,12,0,12" Background="#223341" Foreground="{StaticResource AccentBrush}"
                        BorderBrush="#3D555F" Padding="10">
                <StackPanel Margin="5">
                  <TextBox x:Name="ImportInput" Height="72" AcceptsReturn="True" TextWrapping="Wrap"
                           VerticalScrollBarVisibility="Auto" Style="{StaticResource InputStyle}"
                           FlowDirection="LeftToRight" ToolTip="لینک HTTPS یا کانفیگ خام در هر خط"/>
                  <Button x:Name="ImportButton" Content="ذخیره امن کانفیگ" Click="Import_Click"
                          Margin="0,10,0,0" Background="#35665C" BorderBrush="#57998B"/>
                  <TextBlock x:Name="ImportFeedback" Style="{StaticResource MutedStyle}" FontSize="11"/>
                </StackPanel>
              </Expander>
              <TextBlock x:Name="GroupCounter" Text="هنوز اشتراکی افزوده نشده" FontWeight="Bold" FontSize="15"
                         Margin="0,4,0,12"/>
            </StackPanel>
            <ListBox Grid.Row="1" ItemsSource="{Binding Entries}" Background="Transparent"
                     BorderThickness="0" Foreground="#F5F8FC" ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                  <Setter Property="Padding" Value="0"/>
                  <Setter Property="Margin" Value="0,0,0,9"/>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border CornerRadius="15" Padding="13" Background="#223341">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="Bold"/>
                        <TextBlock Text="🔒 ذخیره‌شده با DPAPI · اتصال غیرفعال" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                      </StackPanel>
                      <Expander Grid.Column="1" Header="مدیریت" Padding="4" Foreground="{StaticResource MutedBrush}">
                        <Button Content="حذف ورودی" Click="Remove_Click" Tag="{Binding}"
                                Margin="0,8,0,0" Foreground="#FFB9B9"/>
                      </Expander>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>

          <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="تنظیمات و به‌روزرسانی" Style="{StaticResource TitleStyle}"/>
              <Border Background="#223341" CornerRadius="18" Padding="18" Margin="0,8,0,15">
                <StackPanel>
                  <TextBlock Text="نسخه Windows" FontSize="16" FontWeight="Bold"/>
                  <TextBlock x:Name="CurrentWinVersion" Text="Windows Preview" Foreground="{StaticResource MutedBrush}"
                             FontSize="12" Margin="0,6,0,14"/>
                  <TextBlock x:Name="UpdateStatus" Text="برای بررسی نسخه جدید از GitHub رسمی استفاده کنید."
                             TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,0,0,10"/>
                  <ProgressBar x:Name="UpdateProgress" Minimum="0" Maximum="100" Height="6"
                               Visibility="Collapsed" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10"/>
                  <WrapPanel>
                    <Button x:Name="CheckUpdateButton" Content="بررسی نسخه جدید" Click="CheckUpdate_Click"/>
                    <Button x:Name="DownloadUpdateButton" Content="دانلود نسخه" Click="DownloadUpdate_Click"
                            IsEnabled="False" Margin="8,0,0,8"/>
                    <Button x:Name="InstallUpdateButton" Content="نصب نسخه دانلودشده" Click="InstallUpdate_Click"
                            IsEnabled="False" Background="#35665C" BorderBrush="#57998B"
                            Margin="8,0,0,8"/>
                  </WrapPanel>
                  <TextBlock Text="فایل نصب ابتدا با SHA-256 نسخه منتشرشده بررسی می‌شود؛ نصب فقط با تأیید شما انجام می‌گیرد."
                             Style="{StaticResource MutedStyle}" FontSize="11"/>
                  <TextBlock Text="این پیش‌نمایش هنوز امضای ناشر معتبر ویندوز ندارد؛ ممکن است SmartScreen هشدار دهد."
                             Foreground="#F5C78A" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/>
                </StackPanel>
              </Border>
              <Border Background="#223341" CornerRadius="18" Padding="18" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="حریم خصوصی" FontSize="16" FontWeight="Bold"/>
                  <TextBlock Text="آدرس‌ها و کلیدهای اشتراک با Windows DPAPI ذخیره می‌شوند؛ برنامه آن‌ها را در داشبورد نمایش نمی‌دهد."
                             Style="{StaticResource MutedStyle}" Margin="0,8,0,0" FontSize="12"/>
                </StackPanel>
              </Border>
              <Border Background="#223341" CornerRadius="18" Padding="18">
                <StackPanel>
                  <TextBlock Text="وضعیت موتور VPN" FontSize="16" FontWeight="Bold"/>
                  <TextBlock Text="هنوز Xray و TUN ویندوز پیاده‌سازی نشده‌اند. دکمه اتصال تا تکمیل و تست موتور غیرفعال می‌ماند."
                             Style="{StaticResource MutedStyle}" Margin="0,8,0,0" FontSize="12"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <TextBlock Grid.Row="2" Text="NoraProxy Windows Preview · بدون موتور VPN · اشتراک‌ها فقط روی دستگاه شما ذخیره می‌شوند"
               FontSize="11" Foreground="{StaticResource MutedBrush}"
               VerticalAlignment="Center" HorizontalAlignment="Center"/>
  </Grid>
</Window>
