<Window x:Class="NoraProxy.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NoraProxy — Windows" Width="1120" Height="720" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft"
        Background="{StaticResource CanvasBrush}" FontFamily="Segoe UI">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="88"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="30"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="56" Height="56" CornerRadius="17" Background="#1C3B4A" Margin="0,0,0,0">
          <TextBlock Text="N" FontFamily="Segoe UI" FontWeight="Bold" FontSize="32"
                     Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="NoraProxy" FontSize="26" FontWeight="Bold" FlowDirection="LeftToRight"/>
          <TextBlock Text="نسخه آزمایشی رابط ویندوز — ۰.۱.۱" Style="{StaticResource MutedStyle}" FontSize="12"/>
        </StackPanel>
      </StackPanel>
      <Border Grid.Column="1" Background="#302A42" CornerRadius="18" Padding="16,9" VerticalAlignment="Center">
        <TextBlock Text="●  موتور VPN هنوز متصل نشده" Foreground="#DCC7FF" FontSize="12"/>
      </Border>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#17222D" CornerRadius="24" Padding="16,24">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="5,0,5,5">
            <Separator Background="#304354" Margin="0,0,0,16"/>
            <TextBlock Text="Windows Desktop" Foreground="{StaticResource AccentBrush}" FontSize="14" FontWeight="Bold"/>
            <TextBlock Text="زیرساخت مستقل از اندروید" Style="{StaticResource MutedStyle}" FontSize="11"/>
          </StackPanel>
          <StackPanel>
            <TextBlock Text="داشبورد" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="6,0,6,18"/>
            <Button Content="⌂   صفحه اصلی" Click="Home_Click"/>
            <Button Content="◎   لوکیشن‌ها" Click="Locations_Click"/>
            <Button Content="▤   اشتراک‌ها" Click="Subscriptions_Click"/>
            <Button Content="⚙   تنظیمات" Click="Settings_Click"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Grid.Column="2" CornerRadius="24" Background="#131D27" Padding="30,26">
        <Grid>
          <!-- Home: never suggest that an unimplemented network tunnel works. -->
          <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="خوش آمدید به NoraProxy" Style="{StaticResource TitleStyle}"/>
              <TextBlock Text="اپلیکیشن ویندوز، با هویت مستقل و مسیر توسعه‌پذیر" Style="{StaticResource MutedStyle}" FontSize="14"/>
              <Border Background="#202C39" CornerRadius="24" Padding="22" Margin="0,24,0,22">
                <StackPanel HorizontalAlignment="Center">
                  <Border Width="136" Height="136" CornerRadius="68" Background="#183641" BorderBrush="#76EAD0" BorderThickness="4">
                    <TextBlock Text="⏻" FontSize="70" FontWeight="Light" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource AccentBrush}"/>
                  </Border>
                  <TextBlock Text="وضعیت: قطع" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,16,0,8"/>
                  <TextBlock Text="اتصال پس از یکپارچه‌سازی و تست موتور Xray در ویندوز فعال می‌شود."
                             Style="{StaticResource MutedStyle}" TextAlignment="Center"/>
                  <Button x:Name="ConnectButton" Content="اتصال (هنوز در دسترس نیست)" IsEnabled="False"
                          Width="280" Margin="0,20,0,2"/>
                </StackPanel>
              </Border>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="16" Background="#1B2935" Padding="19">
                  <StackPanel>
                    <TextBlock Text="اشتراک‌های ذخیره‌شده" Style="{StaticResource MutedStyle}"/>
                    <TextBlock x:Name="HomeSubscriptionCount" Text="۰" FontSize="26" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" Margin="0,6,0,0"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" CornerRadius="16" Background="#1B2935" Padding="19">
                  <StackPanel>
                    <TextBlock Text="پینگ سرور" Style="{StaticResource MutedStyle}"/>
                    <TextBlock Text="اندازه‌گیری نشده" FontSize="19" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer x:Name="LocationsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="لوکیشن‌ها" Style="{StaticResource TitleStyle}"/>
              <TextBlock Text="سرورها بعد از اتصال موتور Xray و پردازش واقعی اشتراک‌ها اینجا نمایش داده می‌شوند."
                         Style="{StaticResource MutedStyle}"/>
              <Border Background="#202C39" CornerRadius="20" Padding="28" Margin="0,24,0,0">
                <StackPanel HorizontalAlignment="Center">
                  <TextBlock Text="🌐" FontSize="46" HorizontalAlignment="Center"/>
                  <TextBlock Text="هنوز سرور قابل انتخابی وجود ندارد" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,8"/>
                  <TextBlock Text="کشور و پینگ ساختگی نمایش داده نمی‌شود." Style="{StaticResource MutedStyle}" TextAlignment="Center"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <Grid x:Name="SubscriptionsPage" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
              <TextBlock Text="اشتراک‌های من" Style="{StaticResource TitleStyle}"/>
              <TextBlock Text="ورود امن لینک اشتراک و کانفیگ خام — فعلاً بدون اتصال یا دریافت خودکار"
                         Style="{StaticResource MutedStyle}"/>
              <Border Margin="0,15,0,14" Background="#202C39" CornerRadius="17" Padding="16">
                <StackPanel>
                  <TextBlock Text="افزودن اشتراک یا کانفیگ" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                  <TextBox x:Name="ImportInput" Height="76" AcceptsReturn="True" TextWrapping="Wrap"
                           VerticalScrollBarVisibility="Auto" Background="#101923" Foreground="#F3F7FC"
                           CaretBrush="White" BorderBrush="#3C5060" Padding="10" FlowDirection="LeftToRight"
                           ToolTip="هر لینک HTTPS یا کانفیگ VLESS/VMess/Trojan/SS در یک خط"/>
                  <Button x:Name="ImportButton" Content="ذخیره امن در ویندوز" Click="Import_Click" Margin="0,12,0,0"/>
                  <TextBlock x:Name="ImportFeedback" Style="{StaticResource MutedStyle}" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
            </StackPanel>
            <TextBlock Grid.Row="1" x:Name="GroupCounter" Text="هنوز اشتراکی افزوده نشده" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>
            <ListBox Grid.Row="2" ItemsSource="{Binding Entries}" Background="Transparent"
                     BorderThickness="0" Foreground="#F3F7FC" ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                  <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border CornerRadius="14" Padding="12" Background="#233240">
                    <DockPanel LastChildFill="True">
                      <Button DockPanel.Dock="Left" Content="حذف" Click="Remove_Click" Tag="{Binding}" Margin="10,0,0,0"/>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="ذخیره‌شده و رمزگذاری‌شده؛ هنوز فعال نیست" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>

          <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="تنظیمات" Style="{StaticResource TitleStyle}"/>
              <Border Background="#202C39" CornerRadius="18" Padding="20" Margin="0,12,0,18">
                <StackPanel>
                  <TextBlock Text="حریم خصوصی و امنیت" FontSize="17" FontWeight="Bold" Margin="0,0,0,12"/>
                  <TextBlock Text="اشتراک‌ها با Windows DPAPI در حساب فعلی ویندوز رمزگذاری می‌شوند. آدرس خصوصی اشتراک یا کلید کانفیگ در رابط نمایش داده نمی‌شود."
                             Style="{StaticResource MutedStyle}"/>
                </StackPanel>
              </Border>
              <Border Background="#202C39" CornerRadius="18" Padding="20">
                <StackPanel>
                  <TextBlock Text="موتور VPN ویندوز" FontSize="17" FontWeight="Bold" Margin="0,0,0,12"/>
                  <TextBlock Text="مرحله بعد: بسته‌بندی Xray، مدیریت TUN ویندوز، DNS و مسیریابی، امضای دیجیتال و تست اتصال واقعی. تا آن مرحله نصب این نسخه فقط برای بررسی رابط و مدیریت ورودی‌هاست."
                             Style="{StaticResource MutedStyle}"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
    <TextBlock Grid.Row="2" Text="NoraProxy Windows Preview • اتصال VPN در این بیلد پیاده‌سازی نشده • اطلاعات اشتراک فقط در رایانه شما ذخیره می‌شود"
               FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
  </Grid>
</Window>

