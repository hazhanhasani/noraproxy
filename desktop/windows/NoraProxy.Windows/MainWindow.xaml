<Window x:Class="NoraProxy.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NoraProxy" Width="542" Height="890" MinWidth="470" MinHeight="750"
        MaxWidth="730" WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft"
        Background="{StaticResource CanvasBrush}" FontFamily="Segoe UI">
  <!-- Same visual hierarchy as Android MainScreen: header, no-scroll Home, bottom tabs. -->
  <Grid MaxWidth="610" HorizontalAlignment="Center" Margin="19,9,19,6">
    <Grid.RowDefinitions>
      <RowDefinition Height="84"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="82"/>
    </Grid.RowDefinitions>

    <!-- Android NoraHeader: real icon, app name, subtitle and state pill. -->
    <Grid Grid.Row="0" VerticalAlignment="Center">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="62"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Border Width="60" Height="60" CornerRadius="20" HorizontalAlignment="Right" BorderBrush="#365575" BorderThickness="1">
        <Border.Background>
          <ImageBrush ImageSource="/NoraProxy;component/Assets/nora_icon.jpg" Stretch="UniformToFill"/>
        </Border.Background>
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
        <TextBlock Text="NoraProxy" FontSize="25" FontWeight="ExtraBold" FlowDirection="LeftToRight"
                   HorizontalAlignment="Right"/>
        <TextBlock Text="امنیت ساده، کنترل هوشمند" Foreground="{StaticResource MutedBrush}" FontSize="11"
                   HorizontalAlignment="Right" Margin="0,4,0,0"/>
      </StackPanel>
      <Border Grid.Column="2" CornerRadius="30" Background="{StaticResource Surface2Brush}" BorderBrush="#365575" BorderThickness="1"
              Padding="12,8" VerticalAlignment="Center">
        <TextBlock x:Name="HeaderStatus" Text="○ خاموش" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
      </Border>
    </Grid>

    <Grid Grid.Row="1">
      <!-- Android NoraHomeContent: same order, card shapes, palette and proportions. -->
      <Grid x:Name="HomePage">
        <Grid.RowDefinitions>
          <RowDefinition Height="8"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="1" Background="#1D3552" CornerRadius="35" BorderBrush="#365575" BorderThickness="1"
                Padding="14,7" HorizontalAlignment="Center">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="7" Height="7" Fill="{StaticResource MutedBrush}" Margin="0,0,8,0"/>
            <TextBlock Text="VPN خاموش است" FontSize="12" FontWeight="Medium"/>
          </StackPanel>
        </Border>
        <TextBlock Grid.Row="2" Text="امنیت در یک نگاه"
                   FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"
                   Margin="0,13,0,0"/>
        <Grid Grid.Row="3" MinHeight="173" VerticalAlignment="Center" HorizontalAlignment="Center">
          <!-- Android's mint/violet sweep-glow power button, inactive honestly. -->
          <Ellipse Width="198" Height="198" Fill="#10243D" Opacity="0.95"/>
          <Ellipse Width="183" Height="183" Stroke="#365575" StrokeThickness="1.5"/>
          <Ellipse Width="160" Height="160" StrokeThickness="9">
            <Ellipse.Stroke>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#8FC5FF" Offset="0"/>
                <GradientStop Color="#FFBC92" Offset="0.54"/>
                <GradientStop Color="#69E6BF" Offset="1"/>
              </LinearGradientBrush>
            </Ellipse.Stroke>
          </Ellipse>
          <Button x:Name="ConnectButton" Width="126" Height="126"
                  Style="{StaticResource NoraPowerStyle}" IsEnabled="False" ToolTip="موتور VPN ویندوز هنوز آماده نیست"/>
        </Grid>
        <TextBlock Grid.Row="4" Text="نسخه پیش‌نمایش ویندوز · اتصال VPN پس از تکمیل موتور Xray/TUN فعال می‌شود"
                   Foreground="{StaticResource MutedBrush}" FontSize="11"
                   HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,12"/>
        <Grid Grid.Row="5" Margin="0,0,0,8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="مسیر اتصال" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Click="Locations_Click" Content="همه لوکیشن‌ها  ←"
                  Style="{StaticResource FlatLinkStyle}"/>
        </Grid>
        <Button Grid.Row="6" Click="Locations_Click" Style="{StaticResource CardButtonStyle}" Margin="0,0,0,12">
          <Grid Margin="12,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource Surface2Brush}" CornerRadius="12"
                    Width="39" Height="39">
              <TextBlock Text="🌐" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
              <TextBlock Text="بدون لوکیشن" FontSize="14" FontWeight="Bold"/>
              <TextBlock Text="مسیر انتخاب‌نشده" Foreground="{StaticResource MutedBrush}"
                         FontSize="10" Margin="0,3,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left">
              <TextBlock Text="پینگ نامشخص" Foreground="{StaticResource MutedBrush}" FontSize="12"
                         FontWeight="SemiBold"/>
              <TextBlock Text="پینگ واقعی" Foreground="{StaticResource MutedBrush}" FontSize="10"
                         HorizontalAlignment="Left" Margin="0,3,0,0"/>
            </StackPanel>
          </Grid>
        </Button>
        <Border Grid.Row="7" Background="{StaticResource SurfaceBrush}" CornerRadius="22" BorderBrush="#365575" BorderThickness="1"
                Padding="15,13" Margin="0,0,0,10">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="حجم باقی‌مانده" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
              <TextBlock Text="نامشخص" FontSize="13" FontWeight="Bold" Margin="0,5,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource Surface2Brush}" Margin="0,0" />
            <StackPanel Grid.Column="2" Margin="14,0,0,0">
              <TextBlock Text="اعتبار اشتراک" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
              <TextBlock Text="نامشخص" FontSize="13" FontWeight="Bold" Margin="0,5,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
        <Grid Grid.Row="8" Margin="0,0,0,7">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="انتخاب سریع کشور" FontSize="14" FontWeight="SemiBold"/>
          <TextBlock Grid.Column="1" Text="۰ لوکیشن" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
        </Grid>
        <Button Grid.Row="9" Click="Locations_Click" Style="{StaticResource CardButtonStyle}" Margin="0,0,0,10">
          <Grid Margin="12,9">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="🌍" FontSize="18" VerticalAlignment="Center" Margin="0,0,9,0"/>
            <TextBlock Grid.Column="1" Text="برای نمایش کشورها، موتور اتصال را فعال کنید"
                       Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="‹" Foreground="{StaticResource AccentBrush}"
                       FontSize="20" Margin="6,0,0,0"/>
          </Grid>
        </Button>
      </Grid>

      <ScrollViewer x:Name="LocationsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock Text="لوکیشن‌ها" Style="{StaticResource TitleStyle}"/>
          <TextBox x:Name="CountrySearch" IsEnabled="False" Style="{StaticResource InputStyle}"
                   Text="جست‌وجوی کشور، شهر یا کد کشور" Margin="0,12,0,10"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="☆ علاقه‌مندی‌ها" IsEnabled="False" Style="{StaticResource ChipButtonStyle}"/>
            <TextBlock Text="۰ کشور" Foreground="{StaticResource MutedBrush}" FontSize="12"
                       Margin="10,8,0,0"/>
          </StackPanel>
          <Border CornerRadius="20" Background="{StaticResource SurfaceBrush}" Padding="22">
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="🌐" FontSize="40" HorizontalAlignment="Center"/>
              <TextBlock Text="هنوز سرور قابل انتخابی وجود ندارد" FontSize="16" FontWeight="Bold"
                         TextAlignment="Center" Margin="0,13,0,8"/>
              <TextBlock Text="پس از تکمیل موتور Xray/TUN، کشورها و پینگ‌های واقعی نشان داده می‌شوند."
                         Style="{StaticResource MutedStyle}" FontSize="12" TextAlignment="Center"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Grid x:Name="SubscriptionsPage" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
          <TextBlock Text="اشتراک" Style="{StaticResource TitleStyle}"/>
          <Expander Header="＋ افزودن کانفیگ یا اشتراک" IsExpanded="True"
                    Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource AccentBrush}"
                    BorderBrush="#33505A" Padding="13" Margin="0,8,0,12">
            <StackPanel>
              <TextBox x:Name="ImportInput" Height="76" AcceptsReturn="True" TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto" Style="{StaticResource InputStyle}"
                       FlowDirection="LeftToRight" ToolTip="هر لینک HTTPS یا کانفیگ خام در یک خط"/>
              <Button x:Name="ImportButton" Content="افزودن و ذخیره کانفیگ" Click="Import_Click"
                      Margin="0,11,0,0" Background="#30537B" BorderBrush="#547DB1"/>
              <TextBlock x:Name="ImportFeedback" Style="{StaticResource MutedStyle}" FontSize="11"/>
            </StackPanel>
          </Expander>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
          <TextBlock Text="گروه‌های من" FontSize="19" FontWeight="Bold" Margin="0,0,0,6"/>
          <TextBlock x:Name="GroupCounter" Text="هنوز اشتراکی افزوده نشده" FontSize="12"
                     Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
        <ListBox Grid.Row="2" ItemsSource="{Binding Entries}" Background="Transparent"
                 BorderThickness="0" Foreground="#F4F8FF">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="Padding" Value="0"/>
              <Setter Property="Margin" Value="0,0,0,9"/>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border CornerRadius="20" Padding="15" Background="{StaticResource SurfaceBrush}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="Bold"/>
                    <TextBlock Text="ذخیره امن · هنوز متصل نیست" FontSize="11"
                               Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                  </StackPanel>
                  <Expander Grid.Column="1" Header="مدیریت گروه" Padding="4"
                            Foreground="{StaticResource MutedBrush}">
                    <Button Content="حذف" Click="Remove_Click" Tag="{Binding}"
                            Margin="0,9,0,0" Foreground="#FFB9B9"/>
                  </Expander>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock Text="تنظیمات" Style="{StaticResource TitleStyle}"/>
          <Border CornerRadius="20" Padding="17" Background="{StaticResource SurfaceBrush}"
                  Margin="0,10,0,13">
            <StackPanel>
              <TextBlock Text="اتصال هوشمند" FontSize="16" FontWeight="Bold"/>
              <TextBlock Text="پس از تکمیل موتور VPN ویندوز فعال خواهد شد"
                         Foreground="{StaticResource MutedBrush}" FontSize="12"
                         TextWrapping="Wrap" Margin="0,6,0,0"/>
              <CheckBox Content="بازیابی خودکار اتصال" IsEnabled="False" Margin="0,15,0,0"
                        Foreground="{StaticResource MutedBrush}" FontSize="12"/>
            </StackPanel>
          </Border>
          <Border CornerRadius="20" Padding="17" Background="{StaticResource SurfaceBrush}"
                  Margin="0,0,0,13">
            <StackPanel>
              <TextBlock Text="به‌روزرسانی برنامه" FontSize="16" FontWeight="Bold"/>
              <TextBlock x:Name="CurrentWinVersion" Text="Windows Preview"
                         Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,7,0,10"/>
              <TextBlock x:Name="UpdateStatus" Text="بررسی انتشارهای رسمی ویندوز در GitHub"
                         Foreground="{StaticResource AccentBrush}" FontSize="12" TextWrapping="Wrap"
                         Margin="0,0,0,10"/>
              <ProgressBar x:Name="UpdateProgress" Visibility="Collapsed" Minimum="0" Maximum="100"
                           Foreground="{StaticResource AccentBrush}" Height="6" Margin="0,0,0,10"/>
              <Button x:Name="CheckUpdateButton" Content="بررسی به‌روزرسانی"
                      Click="CheckUpdate_Click" Margin="0,0,0,9"/>
              <Button x:Name="DownloadUpdateButton" Content="دانلود نسخه جدید"
                      Click="DownloadUpdate_Click" IsEnabled="False" Margin="0,0,0,9"/>
              <Button x:Name="InstallUpdateButton" Content="نصب نسخه دانلودشده"
                      Click="InstallUpdate_Click" IsEnabled="False" Margin="0,0,0,9"/>
              <TextBlock Text="فایل نصب با SHA-256 بررسی می‌شود و فقط با تأیید شما نصب خواهد شد."
                         Style="{StaticResource MutedStyle}" FontSize="11"/>
              <TextBlock Text="نسخه پیش‌نمایش امضای دیجیتال ناشر ندارد؛ SmartScreen ممکن است هشدار دهد."
                         Foreground="#F5C78A" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/>
            </StackPanel>
          </Border>
          <Border CornerRadius="20" Padding="17" Background="{StaticResource SurfaceBrush}">
            <StackPanel>
              <TextBlock Text="حریم خصوصی" FontSize="15" FontWeight="Bold"/>
              <TextBlock Text="اشتراک‌ها با DPAPI روی حساب ویندوز شما رمزگذاری می‌شوند."
                         Style="{StaticResource MutedStyle}" FontSize="12" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Exact Android tabs and icons, fixed at the bottom (not a Windows sidebar). -->
    <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="24" BorderBrush="#365575" BorderThickness="1"
            Padding="7,8,7,8" Margin="-4,7,-4,3">
      <UniformGrid Columns="4" FlowDirection="RightToLeft">
        <Button x:Name="HomeNavButton" Click="Home_Click" Style="{StaticResource BottomTabStyle}">
          <StackPanel HorizontalAlignment="Center">
            <Viewbox Width="24" Height="24" HorizontalAlignment="Center">
              <Canvas Width="24" Height="24">
                <Path Data="M3,10 L12,3 L21,10 M5.5,9.5 L5.5,21 L18.5,21 L18.5,9.5 M10,21 L10,14 L14,14 L14,21"
                      Stroke="{StaticResource AccentBrush}" StrokeThickness="1.9" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
              </Canvas>
            </Viewbox>
            <TextBlock Text="خانه" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="LocationsNavButton" Click="Locations_Click" Style="{StaticResource BottomTabStyle}">
          <StackPanel HorizontalAlignment="Center">
            <Viewbox Width="24" Height="24" HorizontalAlignment="Center">
              <Canvas Width="24" Height="24">
                <Path Data="M12,2 A10,10 0,1 0,12,22 A10,10 0,1 0,12,2 M2,12 L22,12 M12,2 C6.8,7 6.8,17 12,22 M12,2 C17.2,7 17.2,17 12,22"
                      Stroke="{StaticResource MutedBrush}" StrokeThickness="1.9" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
              </Canvas>
            </Viewbox>
            <TextBlock Text="لوکیشن‌ها" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="SubscriptionsNavButton" Click="Subscriptions_Click" Style="{StaticResource BottomTabStyle}">
          <StackPanel HorizontalAlignment="Center">
            <Viewbox Width="24" Height="24" HorizontalAlignment="Center">
              <Canvas Width="24" Height="24">
                <Path Data="M6,3 L15,3 L19,7 L19,21 L6,21 Z M14.8,3 L14.8,7.5 L19,7.5 M9,11 L16,11 M9,15 L16,15 M9,19 L14,19"
                      Stroke="{StaticResource MutedBrush}" StrokeThickness="1.9" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
              </Canvas>
            </Viewbox>
            <TextBlock Text="اشتراک" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="SettingsNavButton" Click="Settings_Click" Style="{StaticResource BottomTabStyle}">
          <StackPanel HorizontalAlignment="Center">
            <Viewbox Width="24" Height="24" HorizontalAlignment="Center">
              <Canvas Width="24" Height="24">
                <Path Data="M12,3 L13.8,3.5 L14.4,5.7 L16.4,6.5 L18.5,5.5 L20,7 L19,9.1 L19.5,11 L21.8,12 L21.2,14 L18.9,14.4 L18,16.2 L19,18.4 L17.4,19.9 L15.1,18.9 L13.3,19.4 L12.5,21.7 L10.3,21.7 L9.5,19.4 L7.7,18.9 L5.4,19.9 L3.8,18.4 L4.8,16.2 L3.9,14.4 L1.6,14 L1,12 L3.3,11 L3.8,9.1 L2.8,7 L4.3,5.5 L6.4,6.5 L8.4,5.7 L9,3.5 Z M11.5,9 A3,3 0,1 0,11.5,15 A3,3 0,1 0,11.5,9"
                      Stroke="{StaticResource MutedBrush}" StrokeThickness="1.9" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
              </Canvas>
            </Viewbox>
            <TextBlock Text="تنظیمات" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center"/>
          </StackPanel>
        </Button>
      </UniformGrid>
    </Border>
  </Grid>
</Window>
