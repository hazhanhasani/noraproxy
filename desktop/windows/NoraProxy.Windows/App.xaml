<Application x:Class="NoraProxy.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="CanvasBrush" Color="#041B25"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#102C39"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#1C3B47"/>
    <SolidColorBrush x:Key="CardBrush" Color="#102C39"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#A5BEC2"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#18B8A9"/>
    <SolidColorBrush x:Key="VioletBrush" Color="#66D9C8"/>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#F1FCFC"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#F1FCFC"/>
      <Setter Property="Background" Value="#17413F"/>
      <Setter Property="BorderBrush" Value="#345862"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,0,7"/>
    </Style>
    <Style x:Key="BottomTabStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="5,7"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="NavPlate" CornerRadius="17" Background="{TemplateBinding Background}"
                    BorderThickness="1" BorderBrush="#345862">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="NavPlate" Property="BorderBrush" Value="#18B8A9"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="NavPlate" Property="BorderBrush" Value="#66D9C8"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CardButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border CornerRadius="18" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FlatLinkStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
    </Style>
    <Style x:Key="ChipButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="NoraPowerStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Ellipse Stroke="#24675F" StrokeThickness="1">
                <Ellipse.Fill>
                  <RadialGradientBrush>
                    <GradientStop Color="#134843" Offset="0"/>
                    <GradientStop Color="#0E2A36" Offset="1"/>
                  </RadialGradientBrush>
                </Ellipse.Fill>
              </Ellipse>
              <Viewbox Width="53" Height="53" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas Width="24" Height="24">
                  <Path Data="M12,2 L12,11 M6.1,5.7 A9,9 0 1 0 17.9,5.7"
                        Stroke="{StaticResource AccentBrush}" StrokeThickness="2.6"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Canvas>
              </Viewbox>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="InputStyle" TargetType="TextBox">
      <Setter Property="Background" Value="#0B2831"/>
      <Setter Property="Foreground" Value="#F1FCFC"/>
      <Setter Property="CaretBrush" Value="#18B8A9"/>
      <Setter Property="Padding" Value="10"/>
      <Setter Property="BorderBrush" Value="#345862"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="TitleStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="ExtraBold"/>
      <Setter Property="Margin" Value="0,0,0,7"/>
    </Style>
    <Style x:Key="MutedStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="22"/>
    </Style>
  </Application.Resources>
</Application>
